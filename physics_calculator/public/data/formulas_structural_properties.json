        "h1": {
          "label": "Height at Point 1",
          "label_bn": "বিন্দু ১ এর উচ্চতা",
          "unit": "m",
          "si_unit": "m"
        },
        "P2": {
          "label": "Pressure at Point 2",
          "label_bn": "বিন্দু ২ এর চাপ",
          "unit": "Pa",
          "si_unit": "Pa"
        },
        "v2": {
          "label": "Velocity at Point 2",
          "label_bn": "বিন্দু ২ এর বেগ",
          "unit": "m/s",
          "si_unit": "m/s"
        },
        "h2": {
          "label": "Height at Point 2",
          "label_bn": "বিন্দু ২ এর উচ্চতা",
          "unit": "m",
          "si_unit": "m"
        },
        "rho": {
          "label": "Fluid Density",
          "label_bn": "প্রবাহীর ঘনত্ব",
          "unit": "kg/m^3",
          "si_unit": "kg/m^3"
        },
        "g": {
          "label": "Gravity",
          "label_bn": "অভিকর্ষজ ত্বরণ",
          "unit": "m/s^2",
          "si_unit": "m/s^2"
        }
      },
      "solve_for": {
        "P2": {
          "expr": "P1 + 0.5*rho*(v1^2 - v2^2) + rho*g*(h1 - h2)",
          "solvable": true
        },
        "P1": {
          "expr": "P2 + 0.5*rho*(v2^2 - v1^2) + rho*g*(h2 - h1)",
          "solvable": true
        },
        "v2": {
          "expr": "sqrt(v1^2 + 2*(P1 - P2)/rho + 2*g*(h1 - h2))",
          "solvable": true
        },
        "v1": {
          "expr": "sqrt(v2^2 + 2*(P2 - P1)/rho + 2*g*(h2 - h1))",
          "solvable": true
        }
      },
      "constraints": [
        "rho > 0",
        "g > 0"
      ],
      "errors": [
        "division_by_zero",
        "negative_sqrt"
      ],
