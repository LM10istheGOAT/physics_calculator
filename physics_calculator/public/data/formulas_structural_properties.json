    {
      "id": "bernoulli_equation",
      "name": "Bernoulli's Equation",
      "name_bn": "বার্নোলির সমীকরণ",
      "type": "bernoulli",
      "chapter": "structural_properties",
      "variables": {
        "P1": {
          "label": "Pressure at Point 1",
          "label_bn": "বিন্দু ১ এর চাপ",
          "unit": "Pa",
          "si_unit": "Pa"
        },
        "v1": {
          "label": "Velocity at Point 1",
